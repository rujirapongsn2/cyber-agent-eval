{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "cyber-agent-eval campaign",
  "type": "object",
  "additionalProperties": false,
  "required": ["campaign_id", "name_th", "description_th", "num_stages", "stages"],
  "properties": {
    "campaign_id": {"type": "string", "pattern": "^CMP-[0-9]{3}$"},
    "name_th": {"type": "string"},
    "description_th": {"type": "string"},
    "num_stages": {"type": "integer"},
    "stages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["stage", "name_th", "case_id", "techniques"],
        "properties": {
          "stage": {"type": "integer"},
          "name_th": {"type": "string"},
          "case_id": {"type": "string", "pattern": "^CAE-[0-9]{4}$"},
          "host": {"type": ["string", "null"]},
          "techniques": {"type": "array", "items": {"type": "string"}}
        }
      }
    }
  }
}
