{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "cyber-agent-eval case input (agent-facing, no answers)",
  "type": "object",
  "additionalProperties": false,
  "required": ["case_id", "task_type", "prompt_th", "input_log_refs"],
  "properties": {
    "case_id": {"type": "string", "pattern": "^CAE-[0-9]{4}$"},
    "task_type": {"type": "string", "enum": ["triage_severity", "ioc_extraction", "attack_mapping", "correlation", "campaign_reconstruction"]},
    "prompt_th": {"type": "string"},
    "input_log_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["source", "file"],
        "properties": {
          "source": {"type": "string"},
          "file": {"type": "string"},
          "line": {"type": "integer"},
          "event_record_id": {"type": "integer"},
          "event_id": {"type": "integer"},
          "host": {"type": "string"}
        }
      }
    }
  }
}
